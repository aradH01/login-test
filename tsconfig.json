{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./",
    "paths": {
      "@/*": ["./app/*"],
      "@assets/*": ["public/assets/*"],
      "@appTypes/*": ["app/_types/*"],
      "@services/*": ["app/api/_services/*"],
      "@components/*": ["app/_components/*"],
      "@app/*": ["app/*"],
      "@stores/*": ["app/_stores/*"],
      "@styles/*": ["app/_styles/*"],
       "@validations/*": ["app/validations/*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts" , "_types/**/*.d.ts" , "app/_types/**/*.d.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
